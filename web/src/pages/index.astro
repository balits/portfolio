---
import { Font } from "astro:assets";
import "../styles/global.css"

const title = "balits_peter_marton"

let header_links = [
	{
		key: "github",
		link: "https://github.com/balits",
		hoverstyle: "hover:bg-myblue hover:text-mywhite"
	},
	{
		key: "mail",
		link: "mailto:balitspm@proton.me",
		hoverstyle: "hover:bg-mygreen hover:text-myblack"
	},
	{
		key: "cv",
		hoverstyle: "hover:bg-myyellow hover:text-myblack",
		link: "/cv.pdf"
	},
]

let footer_links = [
	{
		kind: "anchor",
		key: "check out my github",
		link: "https://github.com/balits",
		hoverstyle: "hover:bg-myblue hover:text-mywhite"
	},
	{
		kind: "anchor",
		key: "send me an email",
		link: "mailto:balitspm@proton.me",
		hoverstyle: "hover:bg-mygreen dark:hover:text-myblack"
	},
	{
		kind: "anchor",
		key: "visit my linkedin",
		link: "https://linkedin.com/in/balits",
		hoverstyle: "hover:bg-myyellow dark:hover:text-myblack"
	},
	{
		kind: "cv",
		key: "download my cv",
		hoverstyle: "hover:bg-myorange dark:hover:text-myblack",
		link: "/cv.pdf"
	},
	{
		kind: "phone",
		key: "give me a call",
		link: "+36 70 383 7491",
		hoverstyle: "hover:bg-myred hover:text-mywhite",
	},
]

let education = [
		{
			"name": "ELTE",
			"kind": "BSc in Computer Science",
			"location": {
				"name": "budapest",
				"code": "hu"
			},
			"duration": {
				"start": "Sep. 2021",
				"end": "June 2026",
			},
			"rows": [
				"Thesis: wrote a 40K lines-of-code etcd clone in Go from scatch, using HashiCorp’s raft library and Kubernetes.",
			]
		},
		{
			"name": "CTU",
			"kind": "Erasmus at the Faculty of Informatics",
			"location": {
				"name": "prague",
				"code": "cz"
			},
			"duration": {
				"start": "Sep. 2024",
				"end": "Feb. 2025",
			},
			"rows": [
				"Semester project: built a CSV spreadsheet engine in Scala focusing on expression lexing, parsing and cell arithmetics.",
			]
		}
]

let experience = [{
	name: "Fornax ICT",
	role: "Backend Developer",
	location: {
		"name": "budapest",
		"code": "hu"
	},
	duration: {
		"start": "Oct. 2025",
		"end": "June 2026",
	},
	rows: [
		"Developed and maintained backend services using Java, Spring Boot and PostgreSQL.",
		"Contributed to internal projects with mature codebases, designed APIs, optimized query performances."
	]
}]

let projects = [
	{
		name: "kave",
		description: "Distrubted key-value store",
		techstack: "Go, Kubernetes, Svelte",
		duration: {
			"start": "Jan. 2025",
			"end": "May 2026",
		},
		rows: [
			"Raft cluster over Kubernetes with fault tolerance, rolling updates, pod distribution and Prometheus metrics.",
			"MVCC as the fundamental concurrency primitive, used for global monotonic revisions, snapshot isolation and transactions.",
			"Leases for attaching TTLs to keys, with a background expiration checker.",
			"Watches for streaming real time changes to subscribed keys over WebSocket.",
			"Secret storage using 1 out of N Oblivious Transfer.",
			"HTTP API endpoints, with follower-to-leader proxying.",
			 "docker-compose for local development, stress and smoke tests, GitHub Actions for CI/CD, civo for deployment.",
		]
	},
	{
		name: "Logregator",
		description: "Time-series log aggregator over TCP",
		techstack: "Rust, Tokio, Glommio",
		duration: {
			"start": "May 2025",
			"end": "Aug. 2026",
		},
		rows: [
			"Async log aggregator designed append-heavy workloads over TCP.",
			"Custom time-series LSM Tree, with SSTables for persistence and WAL for crash recovery.",
			"Label indexed logs inspired by Grafana Loki for fast queries.",
			"Custom benchmarking suite for fine-grain performance tuning and visualizing.",
			"Used cargo workspaces with subcrates for storage engine, tcp server/client, internal benchmarking.",
		]
	},
];

let skills = [
	{ key: "languages", value: "rust, go, scala, java, python, c++, SQL, typescript" }, { key: "technologies", value: "linux, git, make, cargo, Docker, Kubernetes, GitHub Actions" },
	{ key: "systems, protocols", value: "raft consensus, TCP/IP, HTTP, write-ahead logs" },
	{ key: "spoken languages", value: "hungarian, english (fluent), german (B2)" },
]

---

<html lang="en">
	<head>
    <Font cssVariable="--monospaced-font" />

		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="dark light">
		<meta name="theme-color" content="#f4f4f4" media="(prefers-color-scheme: light)">
		<meta name="theme-color" content="#0d0d0d" media="(prefers-color-scheme: dark)">
		<meta name="apple-mobile-web-app-title" content="balits.computer">

		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="manifest" href="/site.webmanifest">

		<title>{title}</title>
	</head>
	<body>
		<main>
			<header class = "flex flex-row w-full justify-between">
				<div class = "uppercase grid gap-y-0">
					<p class = "before:content-['['] after:content-[']'] hover:bg-myblue hover:text-mywhite hover:line-through w-fit">
							balits peter marton
					</p>
					<p class = "before:content-['['] after:content-[']'] hover:bg-mygreen hover:text-myblack hover:line-through w-fit">software engineer</p>
					<p class = "before:content-['['] after:content-[']'] hover:bg-myyellow hover:text-myblack hover:line-through w-fit">24 y/o</p>
				</div>

				<nav>
					<ul class = "uppercase flex flex-col items-end gap-y-0">
						{header_links.map((elem, i) => (
								<li key={i}>
									{
										elem.link == null ? (
											<span class = {`before:content-['['] after:content-[']'] ${elem.hoverstyle}`}>{elem.key}</span>
										) : (
											<a class={`before:content-['['] after:content-[']'] ${elem.hoverstyle}`} href={elem.link}
											  target="_blank"
											>
												<span class="underline hover:no-underline hover:line-through">
													{elem.key}
												</span>
											</a>
										)
									}
								</li>
							))}
					</ul>
				</nav>
			</header>

			<h1 class="mt-8 w-full flex align-center justify-center">
				Resume ~*~ Balits Peter Marton
			</h1>

			<section>
				<h2 class="before:text-mygreen">education</h2>

				<ul>
					{education.map((edu) => (
						<li>
							<div class="flex flex-row w-full justify-between mb-6">
								<div class="flex flex-col w-full justify-start items-start">
									<p class="font-bold">{edu.name}</p>
									<p class="myitalic">{edu.kind}</p>
								</div>

								<div class= "flex flex-col w-full justify-start items-end">
									<p class = "justify-self-end">
										<span class = "capitalize">
											{edu.location.name},&nbsp;
										</span>
										<span class = "uppercase">
											{edu.location.code}
										</span>
									</p>

									<p class = "justify-self-end myitalic">
										{edu.duration.start} - {edu.duration.end}
									</p>
								</div>
							</div>

							<ol>
								{edu.rows.map((row) => (
									<li>
										{row}
									</li>
								))}
							</ol>
						</li>
					))}
				</ul>
			</section>

			<section>
				<h2 class = "before:text-myblue">experience</h2>

				<ul class = "">
					{experience.map((exp) => (
						<li class = "">
							<div class="flex flex-row w-full justify-between mb-6">
								<div class = "flex flex-col w-full justify-start items-start">
									<strong class="">{exp.role}</strong>
									<p class = "myitalic">{exp.name}</p>
								</div>
								<div class = "flex flex-col w-full justify-start items-end">
									<p class = "justify-self-end myitalic">
										{exp.duration.start} - {exp.duration.end}
									</p>
									<p class = "justify-self-end myitalic">
										<span class = "capitalize">
											{exp.location.name},&nbsp;
										</span>
										<span class = "uppercase">
											{exp.location.code}
										</span>
									</p>
								</div>
							</div>

							<ol>
								{exp.rows.map((row) => (
									<li>{row}</li>
								))}
							</ol>
						</li>
					))}
				</ul>
			</section>

			<section>
				<h2 class = "before:text-myyellow">projects</h2>

				<ul>
					{projects.map((proj) => (
						<li class = "grid grid-flow-row">
							<div class="flex flex-row w-full justify-between mb-6">
								<div class = "flex flex-col w-full justify-start items-start">
									<strong>{proj.name}</strong>
									<p class = "myitalic text-tiny md:text-sm">{proj.description}</p>
								</div>

								<div class = "flex flex-col w-full justify-start items-end">
									<p class = "justify-self-end before:content-['['] after:content-[']']">
										{proj.techstack}
									</p>

									<p class = "justify-self-end myitalic text-tiny md:text-sm">
										{proj.duration.start} - {proj.duration.end}
									</p>
								</div>

							</div>

							<ol class = "grid gap-y-2 justify-start grid-flow-cols">
								{proj.rows.map((row) => (
									<li>{row}</li>
								))}
							</ol>
						</li>
					))}

				</ul>
			</section>
			
			<section id="skills-section">
				<h2 class = "before:text-myred">skills</h2>

				<ul class = "concise-ul-px dashed-list">
					{skills.map((skill) => (
						<li>
							<span class ="text-black dark:text-white font-bold">
								[{skill.key}]:&nbsp;
							</span>
							<span>{skill.value}</span>
						</li>
					))}
				</ul>
			</section>

			<footer>
				<section>
					<h2 class = "before:text-myorange">contact</h2>

					<ul class = "concise-ul-px dashed-list">
						{footer_links.map((elem) => {
							switch (elem.kind) {
								case 'phone':
									return (
										<li>
											<span class ="hover:bg-myred hover:text-myblack">
												<span class="before:content-['['] after:content-[']']">
													{elem.key}
												</span>
												<span class="before:content-['('] after:content-[')'] underline">
													{elem.link}
												</span>
											</span>
										</li>
									);
								default:
									return (
										<li>
											<a href={elem.link} class={elem.hoverstyle} target="_blank" rel="noopener, noreferrer">
												<span class="before:content-['['] after:content-[']']">
													{elem.key}
												</span>
												<span class="before:content-['('] after:content-[')']">
													<span class="underline">
														{elem.link}
													</span>
												</span>
											</a>
										</li>
									);
							}
						})}
					</ul>
				</section>
			</footer>
		</main>
	</body>
</html>
